# RPAI Backend Environment Variables Template
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=rpai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/rpai_db

# Razorpay Test Mode Credentials (NEVER expose to frontend)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:5173
